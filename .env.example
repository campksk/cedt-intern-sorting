# Copy this file to ".env" (same folder) and fill in. ".env" is git-ignored.
# For the deployed site, set the same names in Vercel > Settings > Environment Variables.

# Upstream API (current round) that returns { "items": [...], "meta": {...} }. Shown as the "Live" semester.
# All pages are fetched automatically. If the API supports a page-size param, adding it makes it one request:
#   UPSTREAM_URL=https://example/api/openings?limit=1000     (use & if the URL already has a ?)
UPSTREAM_URL=

# Only if the API needs login. Use ONE of these (leave the other empty):
# a) Authorization header -> paste only the part AFTER "Bearer "
UPSTREAM_TOKEN=
# b) Cookie header -> paste the whole value of the request's "Cookie" header
UPSTREAM_COOKIE=

# Only if page auto-detection fails: name of the page-number query param (e.g. page, currentPage)
# UPSTREAM_PAGE_PARAM=

# Cache lifetime in seconds (default 3600)
CACHE_TTL_SEC=3600

# MCV credentials for login (only if UPSTREAM_TOKEN or UPSTREAM_COOKIE is empty)
MCV_USERNAME=
MCV_PASSWORD=

# --- Raspberry Pi publisher mode (scripts/pi-server.js) ---
# System Chromium used for the auto-login (apt install chromium)
# CHROMIUM_PATH=/usr/bin/chromium
# Exact origin(s) of the deployed website allowed to read this API (comma-separated), e.g. https://my-site.pages.dev
# WEB_ORIGINS=
# How often to log in and refresh the data, in hours (default 6)
# REFRESH_HOURS=6
# Listen address/port. Keep 127.0.0.1 and expose it through a tunnel (Tailscale Funnel / Cloudflare Tunnel).
# HOST=127.0.0.1
# PORT=3000
